# Copy to .env for local development. Never commit .env.
# Local values come from `supabase status` after `supabase start`.

# Supabase project URL, e.g. http://127.0.0.1:54321 locally.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; the secret key never goes here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. Locally, use Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
